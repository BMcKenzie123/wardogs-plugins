# ---- RCON connection (copy from the xREALM panel: RCON host / port / password) ----
RCON_HOST=your-server.xrealm.example
RCON_PORT=7776
RCON_PASSWORD=change-me

# https for a TLS listener; http for a loopback listener OR a host-mapped port that is plain HTTP
# (xREALM hands out ip:port that speaks plain HTTP; use http there).
RCON_SCHEME=https

# Hosted RCON listeners commonly present a self-signed certificate.
# Try strict TLS first. If you get a cert error, either:
#   RCON_TLS_INSECURE=1        (accept any cert for this host)  -- or, better --
#   RCON_CA_FILE=./rcon-ca.pem (pin the server cert; see README "TLS")
RCON_TLS_INSECURE=0
RCON_CA_FILE=

RCON_TIMEOUT_MS=10000

# ---- Plugin host ----
# How often the host polls /v1/status + /v1/players. 3000-5000 is what the official panel uses.
POLL_MS=4000
# How often the host polls /v1/audit (only when a plugin subscribes to audit.entry).
AUDIT_POLL_MS=15000
# Where plugins persist state, stats, and logs.
DATA_DIR=./data
# debug | info | warn | error
LOG_LEVEL=info
# Which plugins to enable and their options.
PLUGINS_FILE=./plugins.json

# ---- Optional integrations ----
DISCORD_WEBHOOK_URL=
# Discord bot token for discord-announce-bridge.
DISCORD_BOT_TOKEN=
# Your community Discord invite without https:// (e.g. discord.gg/xxxx). Fills {discord} in every message template.
DISCORD_INVITE=
STEAM_API_KEY=
# Optional shared listener for metrics, dashboard, and health checks.
HTTP_PORT=
# Bind address for that listener. Default 0.0.0.0. Set 127.0.0.1 when Caddy/nginx fronts it (deploy/public-url.sh).
HTTP_BIND=
# Password for the admin-panel plugin (HTTP Basic auth, any username). 8+ chars; keep the panel behind HTTPS or a VPN.
ADMIN_PASSWORD=
# Named admins instead of (or as well as) the shared password; actions are logged under the name.
# Make entries with `wd admin-hash <name>` (it prints a generated password once) and join them with commas:
#   ADMIN_USERS=jdam:scrypt:<salt>:<hash>,ralf:scrypt:<salt>:<hash>
ADMIN_USERS=
# Timezone for schedule-based plugins (lighting-clock). Any IANA zone.
TZ=UTC

# After a map change or a mass drop, players who reappear within this window keep their session (no leave/join, no welcome DM). Default 120000 ms.
RECONNECT_GRACE_MS=

# Pacing for everything plugins say to players. Admin messages from the panel are not paced.
DM_PER_MINUTE=12
BROADCAST_PER_MINUTE=4
DM_GAP_SECONDS=180
